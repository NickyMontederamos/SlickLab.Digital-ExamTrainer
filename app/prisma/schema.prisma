// CM-Law SecureExam — Phase 1 data model
// See docs/ARCHITECTURE_DECISIONS.md ADR-003 for why Prisma, and
// src/lib/tenant-db.ts for how tenant isolation is enforced at the query layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PLATFORM_ADMIN
  INSTITUTION_ADMIN
  FACULTY
  PROCTOR
  STUDENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  TRUE_FALSE
  ESSAY
  SHORT_ANSWER
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// STANDARD is every exam faculty write themselves. BENCHMARK exams live in
/// a Course.isBenchmarkBank course and are never taken directly — they're
/// duplicated into a live course as a STANDARD exam via LinkedAssessment
/// (see the comment on that model). Only a Course.isBenchmarkBank course can
/// contain a BENCHMARK exam — enforced server-side in exams.ts's
/// createExam(), not just hidden in the UI.
enum ExamKind {
  STANDARD
  BENCHMARK
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  /// Auto-paused by the 3-strike integrity monitor, pending faculty review
  /// (see AttemptEvent) — not a final state. Faculty either reinstates (back
  /// to IN_PROGRESS) or confirms as TERMINATED.
  INTERRUPTED
  /// Confirmed integrity violation — terminal, like SUBMITTED/GRADED, but
  /// distinct so the result view can show why instead of a plain score.
  TERMINATED
  SUBMITTED
  GRADED
}

enum AttemptEventType {
  WINDOW_BLUR
  VISIBILITY_HIDDEN
  FULLSCREEN_EXIT
  /// Logged for faculty context only — never counted toward the 3-strike
  /// threshold (see integrity.ts's STRIKE_EVENT_TYPES). A dropped connection
  /// isn't the student's fault and must never be treated as misconduct.
  NETWORK_OFFLINE
  NETWORK_ONLINE
}

enum AuditResult {
  SUCCESS
  DENIED
  ERROR
}

enum AccountTokenType {
  /// Set by inviteUser() when an admin creates an account with no
  /// admin-known password — the invited person sets their own via this
  /// token instead. See docs/ARCHITECTURE_DECISIONS.md on why: an admin
  /// typing/distributing a real password (the old createUser() path,
  /// still kept for tests/back-compat) means the admin has known every
  /// student's password at least once, which is worth not doing.
  INVITE
  /// Self-service "forgot password" — requestPasswordReset() in
  /// account-tokens.ts. Short-lived (1 hour) unlike INVITE's 7 days,
  /// since a reset is meant to be used right away.
  PASSWORD_RESET
}

/// A subscribing school/organization. Every tenant-scoped table carries
/// institutionId; SUPER_ADMIN/PLATFORM_ADMIN users are the only ones allowed
/// a null institutionId (they operate across tenants by design).
model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Institution branding (master prompt §10). Logo paths are relative to
  /// /public — fine for a single-deployment Phase 1 pitch demo; will need
  /// to move to real object storage once institutions self-serve upload.
  logoUrl         String?
  sealUrl         String?
  primaryColor    String?
  secondaryColor  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  departments         Department[]
  courses             Course[]
  questions           Question[]
  exams               Exam[]
  linkedAssessments   LinkedAssessment[]
  examAttempts        ExamAttempt[]
  auditLogs           AuditLog[]
  deviceRegistrations DeviceRegistration[]
  accountTokens       AccountToken[]
}

/// Institution -> Department -> Course. Nullable on Course rather than
/// required: Phase 1's seed/tests create courses directly with no
/// department concept, and a required FK would mean a hand-written backfill
/// migration plus editing every one of those call sites. createCourse() in
/// courses.ts requires a real departmentId going forward — pre-existing
/// courses with a null departmentId just don't show up under a department
/// yet, they aren't in an error state.
model Department {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  createdAt     DateTime    @default(now())

  courses Course[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model User {
  id             String       @id @default(cuid())
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id])
  email          String       @unique
  passwordHash   String
  name           String
  role           Role
  isActive       Boolean      @default(true)
  /// Hard cutoff for existing sessions: any session established before this
  /// instant is rejected on its next request, even if the JWT is otherwise
  /// valid and unexpired. Set whenever access must be cut immediately
  /// rather than at the next periodic revalidation — deactivation and
  /// admin password reset (see users.ts). Null means "no forced cutoff",
  /// which is the normal state for an untouched account.
  ///
  /// This exists because the session strategy is stateless JWT: without a
  /// server-side session table there is nothing to delete, so revocation
  /// has to be expressed as a timestamp the token is checked against.
  sessionsValidAfter DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  coursesTaught       CourseFaculty[]
  coursesProctoring   CourseProctor[]
  enrollments         Enrollment[]
  questionsCreated    Question[]        @relation("QuestionCreatedBy")
  examsCreated        Exam[]            @relation("ExamCreatedBy")
  linkedAssessmentsCreated LinkedAssessment[] @relation("LinkedAssessmentCreatedBy")
  examAttempts        ExamAttempt[]
  answersGraded       ExamAnswer[]      @relation("AnswerGradedBy")
  submissionsVerified Submission[]      @relation("SubmissionVerifiedBy")
  auditLogs           AuditLog[]
  deviceRegistrations DeviceRegistration[]
  accountTokens       AccountToken[]

  @@index([institutionId])
}

model Course {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  /// Nullable — see the comment on Department above.
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  code          String
  name          String
  academicYear  String
  /// Marks this course as a shared institutional catalog of Benchmark
  /// Assessments (see ExamKind) rather than a live teaching course.
  /// Faculty duplicate/link exams OUT of a benchmark-bank course into their
  /// own live course; a benchmark-bank course itself is never where
  /// students take an exam.
  isBenchmarkBank Boolean     @default(false)
  createdAt     DateTime    @default(now())

  faculty     CourseFaculty[]
  proctors    CourseProctor[]
  enrollments Enrollment[]
  questions   Question[]
  exams       Exam[]

  @@unique([institutionId, code, academicYear])
  @@index([institutionId])
  @@index([departmentId])
}

model CourseFaculty {
  id            String      @id @default(cuid())
  institutionId String
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([institutionId])
}

/// Which PROCTOR users may act on a course's exam attempts — same
/// roster-assignment shape as CourseFaculty, kept as its own table rather
/// than reusing CourseFaculty so a user's faculty and proctor assignments
/// stay independent (a PROCTOR is never implicitly a course's faculty).
model CourseProctor {
  id            String      @id @default(cuid())
  institutionId String
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([institutionId])
}

model Enrollment {
  id            String   @id @default(cuid())
  institutionId String
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  enrolledAt    DateTime @default(now())

  @@unique([courseId, userId])
  @@index([institutionId])
}

/// A question is a stable identity; its gradeable content lives in
/// versions so a past exam attempt can permanently reference the exact
/// wording/answer key it was graded against.
model Question {
  id                 String       @id @default(cuid())
  institutionId      String
  institution        Institution  @relation(fields: [institutionId], references: [id])
  courseId           String?
  course             Course?      @relation(fields: [courseId], references: [id])
  type               QuestionType
  difficulty         String?
  tags               String[]
  learningObjectives String[]
  createdById        String
  createdBy          User         @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())

  versions      QuestionVersion[]
  examQuestions ExamQuestion[]

  @@index([institutionId])
  @@index([courseId])
}

model QuestionVersion {
  id            String   @id @default(cuid())
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  versionNumber Int
  prompt        String
  /// Choices for MC/MR/TF; null for essay/short-answer.
  choices       Json?
  /// Correct answer key; withheld from student-facing API responses.
  correctAnswer Json?
  points        Float
  createdAt     DateTime @default(now())

  examQuestions ExamQuestion[]

  @@unique([questionId, versionNumber])
}

model Exam {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id])
  title         String
  status        ExamStatus  @default(DRAFT)
  kind          ExamKind    @default(STANDARD)
  createdById   String
  createdBy     User        @relation("ExamCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  versions ExamVersion[]
  linkedAsSource LinkedAssessment[] @relation("LinkedAssessmentSource")
  linkedAsCopy   LinkedAssessment?  @relation("LinkedAssessmentLinked")

  @@index([institutionId])
  @@index([courseId])
}

/// Records that `linkedExam` is a duplicated copy of `sourceExam` (a
/// BENCHMARK exam), created by duplicateBenchmarkExam() in benchmarks.ts.
/// Drives two things: the combined-report query (every linkedExam sharing
/// a sourceExamId is one "posting" of the same benchmark), and the
/// question-lock check in exams.ts (a linkedExam's questions can never be
/// added/removed, matching the real product's "cannot edit questions on
/// existing or new assessment").
model LinkedAssessment {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  sourceExamId  String
  sourceExam    Exam        @relation("LinkedAssessmentSource", fields: [sourceExamId], references: [id])
  linkedExamId  String      @unique
  linkedExam    Exam        @relation("LinkedAssessmentLinked", fields: [linkedExamId], references: [id])
  createdById   String
  createdBy     User        @relation("LinkedAssessmentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([institutionId])
  @@index([sourceExamId])
}

/// Immutable once published (master prompt §11: "Do not silently mutate the
/// active exam version"). Edits after publish create a new version instead.
model ExamVersion {
  id                  String   @id @default(cuid())
  examId              String
  exam                Exam     @relation(fields: [examId], references: [id])
  versionNumber       Int
  isActive            Boolean  @default(true)
  instructions        String?
  timeLimitMinutes    Int
  availableFrom       DateTime?
  availableUntil      DateTime?
  allowBacktracking   Boolean  @default(true)
  randomizeQuestions  Boolean  @default(false)
  randomizeAnswers    Boolean  @default(false)
  reviewModeEnabled   Boolean  @default(true)
  calculatorAllowed   Boolean  @default(false)
  attachmentsAllowed  Boolean  @default(false)
  securityPolicy      Json?
  /// Drives whether ExamEntryGate runs its device/identity/room-scan
  /// sequence (Examplify's real ExamID + ExamMonitor pairing) before the
  /// proctor-approval step, and whether ExamDownloadGate's settings screen
  /// shows the ExamID/ExamMonitor tiles. Defaults true so exams created
  /// before this field existed keep their current (always-on) behavior.
  examMonitoringEnabled Boolean @default(true)
  /// Real, faculty-set exam-tool flags shown on the pre-exam settings
  /// screen (Examplify's "Exam Tools" panel). Same posture as the existing
  /// calculatorAllowed above: a real stored setting, accurately displayed —
  /// runtime enforcement in the exam-taking UI (spellcheck attribute,
  /// copy/paste blocking, a highlight feature) is not yet built, matching
  /// calculatorAllowed's own current scope.
  spellCheckAllowed   Boolean  @default(true)
  copyPasteAllowed    Boolean  @default(true)
  highlightingAllowed Boolean  @default(true)
  /// Post Assessment Settings (docs reference: ExamSoft's "Post an
  /// Assessment" faculty workflow). Plaintext, not a real security
  /// boundary — same honesty posture as ExamDownloadGate's "Non-Secure"
  /// label. Legacy exams created before this phase have all of these
  /// null/default, and ExamDownloadGate/validateAndRecordDownload fall
  /// back to the original permissive behavior when so.
  assessmentPassword      String?
  /// Lets a student self-resume their OWN interrupted attempt without
  /// faculty review — see resumeAttemptWithCode in integrity.ts. Reusable
  /// (works for every pause of an attempt on this exam), matching the
  /// "Universal" naming, not single-use.
  universalResumeCode     String?
  downloadStartAt         DateTime?
  downloadEndAt           DateTime?
  maxDownloads            Int?
  /// Enforced client-side only, on render — see ExamDownloadGate's
  /// docstring. No background job scheduler exists in this project to
  /// push a real remote deletion.
  remoteDeletionAt        DateTime?
  /// Stored but inert — there is no meaningful offline/online distinction
  /// in a web app that already requires network to load the page at all.
  pingAndRelease          Boolean  @default(false)
  /// Stored but inert — no email infrastructure exists in this project to
  /// send a real reminder.
  sendDownloadEndReminder    Boolean @default(false)
  sendUploadDeadlineReminder Boolean @default(false)
  createdAt           DateTime @default(now())

  examQuestions ExamQuestion[]
  examAttempts  ExamAttempt[]

  @@unique([examId, versionNumber])
}

model ExamQuestion {
  id                String          @id @default(cuid())
  examVersionId     String
  examVersion       ExamVersion     @relation(fields: [examVersionId], references: [id])
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id])
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id])
  order             Int
  points            Float
  /// Optional grouping label (Examplify's "Sections" panel, e.g. "General
  /// Math" / "Reading Comp"). Null means this exam has no sections — the
  /// pre-exam settings screen only shows a Sections list when at least one
  /// question on the exam has this set.
  sectionTitle      String?

  examAnswers ExamAnswer[]

  @@unique([examVersionId, questionId])
}

model ExamAttempt {
  id                  String        @id @default(cuid())
  institutionId       String
  institution         Institution   @relation(fields: [institutionId], references: [id])
  examVersionId       String
  examVersion         ExamVersion   @relation(fields: [examVersionId], references: [id])
  studentId           String
  student             User          @relation(fields: [studentId], references: [id])
  status              AttemptStatus @default(NOT_STARTED)
  /// Student-picked instant within the exam's availableFrom/availableUntil
  /// window (see bookAttempt in attempts.ts). Null when the exam has no
  /// window at all — booking is then "anytime", same as before this field
  /// existed. Informational only in Phase 1: does not yet gate when Start
  /// Exam can be clicked (tracked in docs/PITCH_ROADMAP.md as deferred
  /// hardening).
  scheduledFor        DateTime?
  /// Set when the student finishes the entry gate's device/identity/room
  /// checks and signals "ready to start, waiting for a proctor" — the real
  /// replacement for the old scripted "Waiting for proctor…" delay. Null
  /// means no request has been made yet.
  proctorRequestedAt  DateTime?
  /// Set when a proctor assigned to this exam's course approves the
  /// request above. beginBookedAttempt() refuses to start the timer until
  /// this is set (see ProctorApprovalRequiredError in attempts.ts) — this
  /// is the real gate that replaces the mocked delay.
  proctorApprovedAt   DateTime?
  startedAt           DateTime?
  /// The authoritative deadline for this attempt — the single source of
  /// truth the server enforces on every write (see attemptDeadline() in
  /// attempts.ts). Set when the timer actually begins, NOT when the
  /// attempt row is created, so the booking/entry-gate sequence never
  /// burns exam time. Stored explicitly rather than derived from
  /// startedAt + timeLimitMinutes so that pause time (INTERRUPTED, see
  /// pausedAt) and any future proctor time-extension can move it without
  /// rewriting startedAt, which must keep meaning "when the exam began".
  /// Null on legacy rows created before this column existed — callers fall
  /// back to startedAt + timeLimitMinutes for those.
  expiresAt           DateTime?
  /// When the current INTERRUPTED pause began. On reinstatement the paused
  /// duration is added back to expiresAt, so a student is never charged
  /// exam time for a faculty review — least of all one that clears them.
  /// Null whenever the attempt is not currently paused.
  pausedAt            DateTime?
  submittedAt         DateTime?
  gradedAt            DateTime?
  deviceId            String?
  timeRemainingSeconds Int?
  /// Counts successful unlocks via ExamDownloadGate against
  /// examVersion.maxDownloads — including re-downloads after "Remove Exam
  /// Download" (this counts unlock attempts, not distinct devices).
  downloadCount       Int           @default(0)
  createdAt           DateTime      @default(now())

  answers    ExamAnswer[]
  submission Submission?
  events     AttemptEvent[]

  @@unique([examVersionId, studentId])
  @@index([institutionId])
}

/// Append-only integrity signal log (master prompt anti-cheat scope). Every
/// blur/visibility/fullscreen-exit signal is recorded here regardless of
/// whether it crosses the warning threshold — the visible "Warning X of 3"
/// counter is a derived read of this table, never the source of truth. No
/// institutionId of its own, same reasoning as ExamAnswer — ownership is
/// verified via the parent attempt's institutionId (see integrity.ts).
model AttemptEvent {
  id         String           @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt      @relation(fields: [attemptId], references: [id])
  type       AttemptEventType
  occurredAt DateTime         @default(now())

  @@index([attemptId])
}

model ExamAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id])
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id])
  responseJson   Json?
  isFlagged      Boolean      @default(false)
  savedAt        DateTime     @updatedAt

  /// Auto-graded on submission for objective types (MC/MR/TF); left null
  /// for essay/short-answer until a faculty member grades it manually
  /// (master prompt §21). autoGraded distinguishes the two for the UI/audit
  /// trail even after a manual override.
  pointsAwarded Float?
  autoGraded    Boolean   @default(false)
  gradedAt      DateTime?
  gradedById    String?
  gradedBy      User?     @relation("AnswerGradedBy", fields: [gradedById], references: [id])

  @@unique([attemptId, examQuestionId])
}

model Submission {
  id                  String      @id @default(cuid())
  attemptId           String      @unique
  attempt             ExamAttempt @relation(fields: [attemptId], references: [id])
  encryptedPayloadRef  String?
  signature            String?
  receiptId            String      @unique @default(cuid())
  uploadedAt            DateTime    @default(now())
  /// The real "approve to finish" step (docs/PITCH_ROADMAP.md Milestone 5):
  /// a student sees their result only once a proctor sets this — see
  /// verifySubmission in proctoring.ts. Never set by submitAttempt itself.
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?       @relation("SubmissionVerifiedBy", fields: [verifiedById], references: [id])
  /// Faculty-controlled "Release Results" timestamp (Reporting article:
  /// faculty pick which exam-takers receive their Individual Strengths &
  /// Opportunities report, and when). Purely additive — does NOT replace
  /// or gate the existing verifiedAt-based result-visibility check in
  /// getAttemptResult; a student already sees their graded result once
  /// verified, exactly as before this field existed. This just lets
  /// releaseResults() (reporting.ts) record a real release event to show
  /// faculty/students when it happened, without silently hiding results
  /// that were already visible.
  resultsReleasedAt     DateTime?
}

/// WHO / WHAT / WHEN / WHERE / RESULT (master prompt §20). Append-only in
/// practice — application code must never expose an update/delete path.
model AuditLog {
  id            String       @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  actorUserId   String?
  actor         User?        @relation(fields: [actorUserId], references: [id])
  action        String
  resourceType  String
  resourceId    String?
  result        AuditResult
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime     @default(now())

  @@index([institutionId])
  @@index([actorUserId])
  @@index([createdAt])
}

/// Single-use bearer tokens for invite-based account setup and self-service
/// password reset — see src/lib/account-tokens.ts. Only tokenHash is ever
/// stored (sha256 of the raw token); the raw token exists only in the
/// generated URL, exactly once, at creation time. institutionId is
/// denormalized from the user for forTenant() scoping on the admin-facing
/// side (issuing an invite); redemption (consumeAccountToken) is
/// necessarily unscoped via forPlatform() — the visitor has no session yet,
/// same reasoning as auth.ts's login lookup.
model AccountToken {
  id            String           @id @default(cuid())
  institutionId String?
  institution   Institution?     @relation(fields: [institutionId], references: [id])
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  type          AccountTokenType
  tokenHash     String           @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([institutionId])
  @@index([userId])
}

/// DB-backed replacement for rate-limit.ts's original in-memory bucket —
/// see that file's own comment on why in-memory doesn't work once the app
/// runs as multiple serverless instances (Vercel), which it now does.
/// Append-only; a row per attempt, pruned implicitly by only ever querying
/// the last WINDOW_MS — no separate cleanup job needed at Phase 1 volume.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// Lowercased email being attempted — same key shape as the old
  /// in-memory bucket's `login:${email}`. No institutionId: rate-limiting
  /// must work before the tenant is known, exactly like login itself.
  emailKey   String
  occurredAt DateTime @default(now())

  @@index([emailKey, occurredAt])
}

model DeviceRegistration {
  id                String      @id @default(cuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id])
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  deviceFingerprint String
  registeredAt      DateTime    @default(now())
  lastSeenAt        DateTime    @updatedAt

  @@unique([userId, deviceFingerprint])
  @@index([institutionId])
}
